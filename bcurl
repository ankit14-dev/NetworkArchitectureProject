#!/usr/bin/env python3
"""
bcurl - Binary HTTP Client
Usage: ./bcurl [-v] <host:port/path>
"""

import re
import socket
import sys
from typing import Optional, Tuple
from urllib.parse import urlparse

import bprotocol


def parse_target(target: str) -> Tuple[str, int, str]:
    """
    Parses a target string into (host, port, path).
    Accepts:
      - localhost:9000/index.html
      - 127.0.0.1:9000/
      - http://localhost:9000/index.html
      - localhost:9000
    """
    if "://" not in target:
        target = "bhttp://" + target

    parsed = urlparse(target)
    host = parsed.hostname or "localhost"
    port = parsed.port or 80
    path = parsed.path
    if not path:
        path = "/"
    if parsed.query:
        path += "?" + parsed.query

    return host, port, path


def main():
    args = sys.argv[1:]
    verbose = False
    target_str = None

    for arg in args:
        if arg == "-v" or arg == "--verbose":
            verbose = True
        elif not arg.startswith("-") and target_str is None:
            target_str = arg
        else:
            print(f"Unknown option or multiple targets: {arg}", file=sys.stderr)
            print("Usage: ./bcurl [-v] <host:port/path>", file=sys.stderr)
            sys.exit(2)

    if not target_str:
        print("Usage: ./bcurl [-v] <host:port/path>", file=sys.stderr)
        sys.exit(2)

    try:
        host, port, path = parse_target(target_str)
    except Exception as e:
        print(f"Error parsing target URL '{target_str}': {e}", file=sys.stderr)
        sys.exit(2)

    # Establish the single TCP connection
    try:
        sock = socket.create_connection((host, port), timeout=10.0)
    except Exception as e:
        print(f"Connection error to {host}:{port}: {e}", file=sys.stderr)
        sys.exit(1)

    try:
        stream_id = 1

        # Construct request headers
        req_headers = [
            (":method", "GET"),
            (":path", path),
            ("host", f"{host}:{port}"),
            ("user-agent", "bcurl/1.0"),
            ("accept", "*/*"),
        ]

        encoded_headers = bprotocol.encode_headers(req_headers)
        # For a GET request without body, set FLAG_END_STREAM (0x01)
        req_frame = bprotocol.pack_frame(
            bprotocol.FRAME_HEADERS,
            bprotocol.FLAG_END_STREAM,
            stream_id,
            encoded_headers
        )

        if verbose:
            hdr_desc = bprotocol.describe_frame(
                bprotocol.FRAME_HEADERS,
                bprotocol.FLAG_END_STREAM,
                stream_id,
                len(encoded_headers)
            )
            sys.stderr.write(f">>> [SENT FRAME] {hdr_desc}\n")
            sys.stderr.write(bprotocol.format_hexdump(req_frame, prefix=">>> ") + "\n\n")
            sys.stderr.flush()

        sock.sendall(req_frame)

        # Receive frames
        status_code: Optional[int] = None
        body_chunks = []
        end_stream_seen = False

        while not end_stream_seen:
            frame_info = bprotocol.read_frame(sock)
            if frame_info is None:
                # EOF before END_STREAM
                break

            frame_type, flags, f_stream_id, payload, raw_frame = frame_info

            if verbose:
                hdr_desc = bprotocol.describe_frame(frame_type, flags, f_stream_id, len(payload))
                sys.stderr.write(f"<<< [RECV FRAME] {hdr_desc}\n")
                sys.stderr.write(bprotocol.format_hexdump(raw_frame, prefix="<<< ") + "\n\n")
                sys.stderr.flush()

            # Rule: "A receiver meeting a frame type it does not know MUST skip it cleanly."
            if frame_type not in (bprotocol.FRAME_DATA, bprotocol.FRAME_HEADERS, bprotocol.FRAME_GOAWAY):
                if verbose:
                    sys.stderr.write(f"[*] Skipping unknown frame type 0x{frame_type:02x}\n\n")
                    sys.stderr.flush()
                continue

            if frame_type == bprotocol.FRAME_GOAWAY:
                break

            if frame_type == bprotocol.FRAME_HEADERS:
                try:
                    resp_headers = bprotocol.decode_headers(payload)
                except bprotocol.ProtocolError as e:
                    print(f"Error decoding headers: {e}", file=sys.stderr)
                    sys.exit(1)

                for name, val in resp_headers:
                    if name == ":status":
                        try:
                            status_code = int(val)
                        except ValueError:
                            pass
                    if verbose:
                        sys.stderr.write(f"< {name}: {val}\n")

                if verbose:
                    sys.stderr.write("<\n")
                    sys.stderr.flush()

                if flags & bprotocol.FLAG_END_STREAM:
                    end_stream_seen = True

            elif frame_type == bprotocol.FRAME_DATA:
                body_chunks.append(payload)
                if flags & bprotocol.FLAG_END_STREAM:
                    end_stream_seen = True

        # Write body to stdout
        body_data = b"".join(body_chunks)
        sys.stdout.buffer.write(body_data)
        sys.stdout.buffer.flush()

        # Exit non-zero on 4xx / 5xx
        if status_code is not None and status_code >= 400:
            sys.exit(1)

        sys.exit(0)

    except KeyboardInterrupt:
        sys.exit(130)
    finally:
        sock.close()


if __name__ == "__main__":
    main()
